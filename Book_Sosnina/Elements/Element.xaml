<UserControl x:Class="Book_Sosnina.Elements.Element"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Book_Sosnina.Elements"
             mc:Ignorable="d">
    <Grid Height="100" Background="#FF6AADED" Margin="0,0,0,10" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Name="tbName" Text="" Margin="10,10,10,0" VerticalAlignment="Top" Foreground="White" FontWeight="Bold" Grid.ColumnSpan="3"/>
        <TextBlock Name="tbGenre" Text="" Margin="10,35,10,10" VerticalAlignment="Top" Foreground="White" FontWeight="Bold" />
        <TextBlock Name="tbAuthors" Text="" Margin="10,35,10,10" VerticalAlignment="Top" Foreground="White" FontWeight="Bold" Grid.Column="1"/>
    </Grid>
</UserControl>
