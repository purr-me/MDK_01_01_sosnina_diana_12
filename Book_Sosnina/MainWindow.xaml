<Window x:Class="Book_Sosnina.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Book_Sosnina"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" MinHeight="450" MinWidth="800">
    <Grid>
        <Grid Margin="0,0,-0.4,0" Height="120" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Label Content="#Поиск по наименованию:" Margin="10,10,10,0" VerticalAlignment="Top" FontWeight="Bold" Grid.ColumnSpan="3"/>
            <TextBox Name="tbSearch" KeyUp="Search_Book" Height="23" Margin="10,36,10,0" FontWeight="Bold" TextWrapping="Wrap" />
            <Label Content="#Сортировка:" Margin="10,59,0,0" VerticalAlignment="Top" FontWeight="Bold" Grid.ColumnSpan="3"/>
            <ComboBox Name="cbAuthors" VerticalAlignment="Top" SelectionChanged="SelectAuthors" Margin="10,85,10,0"/>
            <ComboBox Name="cbGenres" VerticalAlignment="Top" SelectionChanged="SelectAuthors" Margin="10,85,10,0" Grid.Column="1"/>
            <ComboBox Name="cbYear" VerticalAlignment="Top" SelectionChanged="SelectAuthors" Margin="10,85,10,0" Grid.Column="2"/>
            
        </Grid>
        <ScrollViewer Margin="0,120,-0.4,0">
            <StackPanel Name="parent">
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
